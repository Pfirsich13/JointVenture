+/**
+ * Startwerte für das Spiel, z. B. join=1234 (Einladungs-Link) oder peerhost=… (nur Tests).
+ *
+ * Normal stehen sie in der Adresse (?join=1234). Lädt JointVenture das Spiel als
+ * hochgeladenes Paket, steht es in einem Rahmen ohne eigene Adresse. Dann gibt die
+ * Seite die Werte über den Namen des Rahmens mit: "jv:join=1234&peerhost=…".
+ */
+export function pageParams(): URLSearchParams {
+  const params = new URLSearchParams(location.search);
+  if (window.name.startsWith("jv:")) {
+    new URLSearchParams(window.name.slice(3)).forEach((value, key) => {
+      if (!params.has(key)) params.set(key, value);
+    });
+  }
+  return params;
+}
